// For format details, see https://aka.ms/devcontainer.json. For config options, see the
{
	"name": "topcoat-hybrid",
	"image": "full",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,bind-propagation=rslave", // Allow mounts later created on the host to show in the container
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"customizations": {
		"vscode": {
			// "settings": {
			// 	"extensions.verifySignature": false
			// },
			"extensions": [
				// general tools
				"usernamehw.errorlens", // Inline diagnostic errors
				// "streetsidesoftware.code-spell-checker", // Spell check
				"redhat.vscode-yaml", // yaml lsp
                "qufiwefefwoyn.inline-sql-syntax", // sql syntax highlighting in strings with `--sql`

				// rust
				"fill-labs.dependi", // dependency validation in Cargo.toml
				"tamasfe.even-better-toml", // toml lsp
				"rust-lang.rust-analyzer", // rust lsp
				"vadimcn.vscode-lldb", // rust debugger




				// HTML/CSS in Topcoat views
				"ecmel.vscode-html-css",
				"jock.svg",

				// sh
				"timonwong.shellcheck", // sh lsp

			]
		}
	},
	"mounts": [
	],
	"runArgs": [
		"--privileged",
		"--net=host",
		"--pids-limit=16384", // Some processes like rustc can spawn more than the default process/thread limit of 2048
		// ssh
		"-v", "${localEnv:HOME}/.ssh/:/root/.ssh",


		// Xdg
		"-e", "DISPLAY=${localEnv:DISPLAY}", // X11 display
		"-e", "WAYLAND_DISPLAY=${localEnv:WAYLAND_DISPLAY}", // Wayland display
		"-e", "XDG_RUNTIME_DIR=${localEnv:XDG_RUNTIME_DIR}", // XDG socket
		"-v", "${localEnv:XDG_RUNTIME_DIR}:${localEnv:XDG_RUNTIME_DIR}", // XDG socket
		"-v", "/tmp/.X11-unix:/tmp/.X11-unix", // X11 socket into the container. Apps inside the container can now connect to DISPLAY to talk to the host's X server.
		"-v", "/dev/dri:/dev/dri", // graphics hardware access


		"--gpus=all",

	],
	"remoteUser": "root",
	"overrideCommand": false, // Vscode by default overrides the container's ENTRYPOINT and CMD with something like `sleep infinity` to keep the container running. Setting this to false means the container will exit if it does not define this.
	"postStartCommand": "git pull --ff-only || true",
}
